# Copy this file to .env and fill in values. .env is gitignored and never leaves your machine.

# --- Database ---
# Path to the local SQLite file. Defaults to data/private/finance.db (gitignored).
# Point this at data/demo/demo.db instead to run against the fictional demo dataset.
DATABASE_URL=sqlite:///./data/private/finance.db

# --- Display defaults ---
DEFAULT_DISPLAY_CURRENCY=EUR

# --- Exchange rates ---
# "frankfurter" (default, free, no key, ECB-backed, supports historical dates)
EXCHANGE_RATE_PROVIDER=frankfurter

# --- AI (analysis + AI-assisted import; all disabled by default) ---
# Master switch. Financial data is never sent anywhere unless this is true.
# Used by both the (not yet built) AI analysis feature and AI-assisted import
# on the Import tab, which sends an uploaded file's contents to the provider
# below so it can propose an account/snapshot mapping.
AI_ANALYSIS_ENABLED=false
# "local" | "anthropic" | "openai" ("openai" is not implemented yet)
AI_PROVIDER=local
# Must be explicitly set to true to allow ANY financial data to leave this machine.
AI_ALLOW_EXTERNAL_DATA=false
AI_MODEL=claude-sonnet-5
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
